<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
  <settings>
    <setting name="mapUnderscoreToCamelCase" value="true"/>
    <setting name="jdbcTypeForNull" value="NULL"/>
  </settings>
  <typeAliases>
    <typeAlias type="com.mycompany.demo.database.entity.Member" alias="member"/>
    <typeAlias type="com.mycompany.demo.database.entity.Seller" alias="seller"/>
    <typeAlias type="com.mycompany.demo.database.entity.Product" alias="product"/>
    <typeAlias type="com.mycompany.demo.database.entity.Orders" alias="orders"/>
    <typeAlias type="com.mycompany.demo.database.entity.OrderItem" alias="orderitem"/>
    <typeAlias type="com.mycompany.demo.database.entity.Board" alias="board"/>
  </typeAliases>
</configuration>